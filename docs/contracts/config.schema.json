{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/autocodex/config.schema.json",
  "title": "autocodex Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mode"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "v1"
      ]
    },
    "profile": {
      "type": "string",
      "enum": [
        "max_capability",
        "balanced",
        "max_throughput"
      ],
      "default": "max_capability"
    },
    "mode": {
      "type": "string",
      "enum": [
        "yolo",
        "safe"
      ],
      "default": "yolo"
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cli_path": {
          "type": "string",
          "default": "codex"
        },
        "model": {
          "type": "string",
          "default": "gpt-5.2-codex"
        },
    "reasoning_effort": {
      "type": "string",
      "enum": [
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ],
      "default": "xhigh",
      "description": "Model-dependent; e.g., gpt-5.1* supports low|medium|high."
    },
    "collaboration_mode": {
      "type": "string",
      "description": "Codex collaboration mode (default: auto, passed via -c collaboration_mode=...)."
    },
    "collaboration_enabled": {
      "type": "boolean",
      "description": "Enable Codex collaboration defaults (default: true). When false, collaboration_mode/preset must be empty."
    },
    "preset": {
      "type": "string",
      "description": "Codex collaboration preset (default: default, passed via -c collaboration_mode_preset=...)."
    },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 900
        },
        "extra_args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "approval_policy": {
          "type": "string",
          "enum": [
            "untrusted",
            "on-failure",
            "on-request",
            "never"
          ],
          "default": "on-request"
        },
        "sandbox_mode": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access"
          ],
          "default": "workspace-write"
        },
        "json_output": {
          "type": "boolean",
          "default": false
        },
        "output_last_message": {
          "type": "boolean",
          "default": false
        },
        "prompt_stdin": {
          "type": "boolean",
          "default": false
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state_dir": {
          "type": "string",
          "default": ".autocodex"
        },
        "memory_dir": {
          "type": "string",
          "default": "memory"
        },
        "logs_dir": {
          "type": "string",
          "default": "logs"
        },
        "artifacts_dir": {
          "type": "string",
          "default": "artifacts"
        },
        "runs_dir": {
          "type": "string",
          "default": "runs"
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "denylist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "plugins"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 60
        }
      }
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "workspaces": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "root"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "root": {
                "type": "string"
              },
              "config_path": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "host": {
          "type": "string",
          "default": "127.0.0.1"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 7788
        },
        "base_path": {
          "type": "string",
          "default": "/"
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "origin": {
          "type": "string"
        }
      }
    },
    "beads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "auto_create": {
          "type": "boolean",
          "default": true
        },
        "auto_update": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info"
        },
        "format": {
          "type": "string",
          "enum": [
            "json",
            "text"
          ],
          "default": "json"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "token_env": {
          "type": "string"
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "bounded",
            "continuous"
          ],
          "default": "bounded"
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "default": 50
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ideate",
              "plan",
              "implement",
              "review",
              "test"
            ]
          },
          "default": [
            "ideate",
            "plan",
            "implement",
            "review",
            "test"
          ]
        },
        "stop_conditions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_duration_seconds": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "max_idle_seconds": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "max_consecutive_failures": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "max_heartbeat_seconds": {
              "type": "integer",
              "minimum": 0,
              "default": 180
            }
          }
        },
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "off",
                "on"
              ],
              "default": "off"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "memory",
                  "events",
                  "artifacts",
                  "snapshot"
                ]
              },
              "default": [
                "memory",
                "events",
                "artifacts"
              ]
            },
            "max_artifacts": {
              "type": "integer",
              "minimum": 0,
              "default": 20
            },
            "max_events": {
              "type": "integer",
              "minimum": 0,
              "default": 200
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "memory_glob": {
              "type": "string",
              "default": "*.md"
            },
            "memory_mode": {
              "type": "string",
              "enum": [
                "inline",
                "summary_ref",
                "ref_only"
              ],
              "default": "summary_ref"
            },
            "snapshot_mode": {
              "type": "string",
              "enum": [
                "inline",
                "summary_ref",
                "ref_only"
              ],
              "default": "summary_ref"
            },
            "summary_max_lines": {
              "type": "integer",
              "minimum": 0,
              "default": 20
            },
            "snapshot_path": {
              "type": "string",
              "default": ""
            }
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retention_days": {
          "type": "integer",
          "minimum": 0,
          "default": 14
        }
      }
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "require_actions": {
          "type": "boolean",
          "description": "Require a valid ACTIONS payload for autonomy runs (defaults to true when autonomy is enabled).",
          "default": true
        },
        "require_next": {
          "type": "boolean",
          "description": "Require explicit next bead selection when multiple beads are ready (defaults to true when autonomy is enabled).",
          "default": true
        },
        "require_bd": {
          "type": "boolean",
          "description": "Require bd to be installed for autonomy runs (defaults to true when autonomy is enabled).",
          "default": true
        },
        "fail_on_schema_error": {
          "type": "boolean",
          "description": "Fail immediately when task/action JSON fails schema validation (default true).",
          "default": true
        },
        "allow_fallback_tasks": {
          "type": "boolean",
          "description": "Allow writing fallback tasks JSON when parsing fails (default true).",
          "default": true
        },
        "keep_invalid_payloads": {
          "type": "boolean",
          "description": "Persist invalid tasks payloads for debugging (default true).",
          "default": true
        },
        "spec_template": {
          "type": "string",
          "default": "docs/specs/TEMPLATE.md"
        },
        "plan_template": {
          "type": "string",
          "default": "docs/plans/TEMPLATE.md"
        },
        "tasks_schema": {
          "type": "string",
          "default": "docs/contracts/autonomy-tasks.schema.json"
        },
        "actions_schema": {
          "type": "string",
          "default": "docs/contracts/autonomy-actions.schema.json"
        },
    "tasks_output_template": {
      "type": "string",
      "default": "docs/plans/%s-tasks.json"
    },
	    "coordinator": {
	      "type": "object",
	      "additionalProperties": false,
	      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "max_parallel": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "default": 2,
          "description": "Maximum concurrent beads. 0 means unlimited."
        },
        "strategy": {
          "type": "string",
          "enum": [
            "bead",
            "phase"
          ],
          "default": "bead"
        },
        "fail_fast": {
          "type": "boolean",
          "default": false,
          "description": "Stop all parallel beads on first error."
	        }
	      }
	    },
	    "harness": {
	      "type": "object",
	      "additionalProperties": false,
	      "properties": {
	        "enabled": {
	          "type": "boolean",
	          "default": false
	        },
	        "impact_mode": {
	          "type": "string",
	          "enum": [
	            "normal",
	            "high"
	          ],
	          "default": "normal"
	        },
	        "strict_tracking_mode": {
	          "type": "string",
	          "enum": [
	            "bd_strict",
	            "offline_evidence_only"
	          ],
	          "default": "bd_strict"
	        },
	        "require_council_on_high_impact": {
	          "type": "boolean",
	          "default": true
	        },
	        "require_independent_critic": {
	          "type": "boolean",
	          "default": true
	        },
	        "require_gate_runner": {
	          "type": "boolean",
	          "default": true
	        },
	        "preflight_command": {
	          "type": "string",
	          "default": "autocodex harness preflight --strict"
	        },
	        "role_pack_path": {
	          "type": "string",
	          "default": ".codex"
	        },
	        "eval": {
	          "type": "object",
	          "additionalProperties": false,
	          "properties": {
	            "enabled": {
	              "type": "boolean",
	              "default": true
	            },
	            "min_scenarios": {
	              "type": "integer",
	              "minimum": 0,
	              "default": 6
	            },
	            "min_pass_rate": {
	              "type": "number",
	              "minimum": 0,
	              "maximum": 1,
	              "default": 1
	            },
	            "max_soft_failures": {
	              "type": "integer",
	              "minimum": 0,
	              "default": 0
	            }
	          }
	        }
	      }
	    },
	        "stop_conditions": {
	          "type": "object",
	          "additionalProperties": false,
	          "properties": {
            "max_fix_attempts": {
              "type": "integer",
              "minimum": 0,
              "default": 3
            },
            "max_beads": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "stop_on_gate_failure": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    }
  }
}
