{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "title": {"type": "string"},
          "headings": {"type": "array", "items": {"type": "string"}},
          "size_bytes": {"type": "integer"},
          "snippet": {"type": "string"}
        },
        "required": ["path", "title", "headings", "size_bytes", "snippet"]
      }
    }
  },
  "required": ["documents"]
}
