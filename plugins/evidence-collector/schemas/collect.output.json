{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {"type": "string"},
          "path": {"type": "string"},
          "size_bytes": {"type": "integer"}
        },
        "required": ["source", "path", "size_bytes"]
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["artifacts", "errors"]
}
